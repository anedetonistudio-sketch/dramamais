# ===== Drama+ — variáveis de ambiente =====
# Sem as variáveis do Supabase o site roda em MODO DEMO (séries de exemplo).

# URL pública do site (sem barra no final) — usada no checkout e nas tags OG
NEXT_PUBLIC_SITE_URL=https://dramamais.com.br

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# NUNCA exponha no navegador. Usada só no servidor (webhook e URLs assinadas).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Mercado Pago (Suas integrações > Credenciais de produção)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
# Opcional: assinatura secreta do webhook (Suas integrações > Webhooks) para validar x-signature
MP_WEBHOOK_SECRET=
